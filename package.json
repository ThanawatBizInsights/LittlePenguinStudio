{
  "name": "little-snowy-owl-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx --yes serve@14 out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "check:release": "npm run build && node scripts/check-release.mjs",
    "build:cloudflare": "node scripts/cf-build.mjs",
    "preview:cloudflare": "wrangler dev --port 8788",
    "deploy:preview": "wrangler versions upload --preview-alias preview",
    "deploy:production": "npm run check:release && WORKERS_CI_BRANCH=main wrangler deploy",
    "test:legacy-redirect": "node --test legacy-redirect/test/redirect.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "wrangler": "4.156.2"
  },
  "engines": {
    "node": ">=22"
  }
}
